---
import Layout from '../components/Layout.astro';
import BandCard from '../components/BandCard.astro';
import bandsData from '../data/bands.json';

interface Band {
  bandName: string;
  bandNameTitleCase: string;
  bandNameSlug: string;
  pdfPath: string;
  exampleLink: string;
  hometown: string;
  genre: string[];
}

const bands: Band[] = (bandsData as Band[]).sort((a, b) =>
  a.bandNameTitleCase.localeCompare(b.bandNameTitleCase, 'de')
);

const allGenres = [...new Set(bands.flatMap((b) => b.genre))].sort((a, b) =>
  a.localeCompare(b, 'de')
);
---

<Layout title="Bandbewerbungen – Schlacht um Otzenhausen 2026">
  <search aria-label="Bands filtern" class="mb-6 flex flex-col gap-4">
    <input
      type="search"
      id="band-search"
      class="search-input"
      placeholder="Band suchen…"
      aria-label="Bands nach Name durchsuchen"
      autocomplete="off"
    />

    <div id="genre-filter" class="flex flex-wrap gap-2" role="group" aria-label="Genre-Filter">
      <button type="button" class="genre-btn" data-genre="all" data-active="true" aria-pressed="true">Alle</button>
      {allGenres.map((genre) => (
        <button type="button" class="genre-btn" data-genre={genre.toLowerCase()} aria-pressed="false">
          {genre}
        </button>
      ))}
    </div>

    <div id="rating-filter" class="filter-bar hidden" role="toolbar" aria-label="Bewertungsfilter">
      <button type="button" class="filter-btn" data-filter="all" data-active="true" aria-pressed="true">Alle</button>
      <button type="button" class="filter-btn" data-filter="up" aria-pressed="false">Daumen hoch</button>
      <button type="button" class="filter-btn" data-filter="down" aria-pressed="false">Daumen runter</button>
    </div>
  </search>

  <p id="band-count" class="mb-6 text-text-secondary" aria-live="polite">
    {bands.length} Bands haben sich beworben
  </p>

  <p id="no-results" class="hidden py-12 text-center text-text-secondary text-lg">
    Keine Bands gefunden.
  </p>

  <div
    id="band-grid"
    class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4"
    role="region"
    aria-label="Bandliste"
  >
    {bands.map((band) => (
      <BandCard
        bandNameTitleCase={band.bandNameTitleCase}
        bandNameSlug={band.bandNameSlug}
        exampleLink={band.exampleLink}
        hometown={band.hometown}
        genre={band.genre}
      />
    ))}
  </div>
</Layout>

<script>
  function initFilters() {
    const RATINGS_KEY = 'bandRatings';
    const filterBar = document.getElementById('rating-filter');
    const bandCount = document.getElementById('band-count');
    const searchInput = document.getElementById('band-search') as HTMLInputElement;
    const genreFilter = document.getElementById('genre-filter');
    const noResults = document.getElementById('no-results');
    const bandGrid = document.getElementById('band-grid');
    const cards = document.querySelectorAll<HTMLElement>('.band-card');
    const totalBands = cards.length;

    let activeRatingFilter = 'all';
    let activeGenres = new Set<string>();
    let searchQuery = '';

    function getRatings(): Record<string, string> {
      try {
        return JSON.parse(localStorage.getItem(RATINGS_KEY) || '{}');
      } catch {
        return {};
      }
    }

    function updateFilterVisibility() {
      if (!filterBar) return;
      const ratings = getRatings();
      const hasRatings = Object.keys(ratings).length > 0;
      filterBar.classList.toggle('hidden', !hasRatings);
    }

    function applyAllFilters() {
      let visibleCount = 0;

      cards.forEach((card) => {
        const bandName = card.dataset.bandName || '';
        const cardGenres = (card.dataset.genres || '').split(',');
        const ratingValue = card.dataset.ratingValue;

        // Search filter
        const matchesSearch = !searchQuery || bandName.includes(searchQuery);

        // Genre filter
        const matchesGenre = activeGenres.size === 0 ||
          cardGenres.some((g) => activeGenres.has(g));

        // Rating filter
        let matchesRating = true;
        if (activeRatingFilter === 'up') {
          matchesRating = ratingValue === 'up';
        } else if (activeRatingFilter === 'down') {
          matchesRating = ratingValue === 'down';
        }

        const show = matchesSearch && matchesGenre && matchesRating;
        card.style.display = show ? '' : 'none';
        if (show) visibleCount++;
      });

      // Update count
      if (bandCount) {
        if (visibleCount === totalBands) {
          bandCount.textContent = `${totalBands} Bands haben sich beworben`;
        } else {
          bandCount.textContent = `${visibleCount} von ${totalBands} Bands`;
        }
      }

      // No results message
      if (noResults && bandGrid) {
        noResults.classList.toggle('hidden', visibleCount > 0);
        bandGrid.classList.toggle('hidden', visibleCount === 0);
      }

      // Update rating button states
      filterBar?.querySelectorAll<HTMLButtonElement>('.filter-btn').forEach((btn) => {
        const isActive = btn.dataset.filter === activeRatingFilter;
        btn.dataset.active = String(isActive);
        btn.setAttribute('aria-pressed', String(isActive));
      });
    }

    // --- Search ---
    searchInput?.addEventListener('input', () => {
      searchQuery = searchInput.value.toLowerCase().trim();
      applyAllFilters();
    });

    // --- Genre filter ---
    genreFilter?.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.genre-btn');
      if (!btn) return;

      const genre = btn.dataset.genre;
      if (!genre) return;

      if (genre === 'all') {
        activeGenres.clear();
        genreFilter.querySelectorAll<HTMLButtonElement>('.genre-btn').forEach((b) => {
          b.dataset.active = String(b.dataset.genre === 'all');
          b.setAttribute('aria-pressed', String(b.dataset.genre === 'all'));
        });
      } else {
        // Toggle this genre
        if (activeGenres.has(genre)) {
          activeGenres.delete(genre);
        } else {
          activeGenres.add(genre);
        }

        // Update button states
        genreFilter.querySelectorAll<HTMLButtonElement>('.genre-btn').forEach((b) => {
          if (b.dataset.genre === 'all') {
            const allActive = activeGenres.size === 0;
            b.dataset.active = String(allActive);
            b.setAttribute('aria-pressed', String(allActive));
          } else {
            const isActive = activeGenres.has(b.dataset.genre || '');
            b.dataset.active = String(isActive);
            b.setAttribute('aria-pressed', String(isActive));
          }
        });
      }

      applyAllFilters();
    });

    // --- Rating filter ---
    updateFilterVisibility();

    document.addEventListener('ratings-changed', () => {
      updateFilterVisibility();
      applyAllFilters();
    });

    filterBar?.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.filter-btn');
      if (!btn) return;

      const filter = btn.dataset.filter;
      if (filter) {
        activeRatingFilter = filter;
        applyAllFilters();
      }
    });
  }

  initFilters();
</script>
