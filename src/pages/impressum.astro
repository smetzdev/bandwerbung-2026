---
import Layout from '../components/Layout.astro';
---

<Layout title="Impressum – Schlacht um Otzenhausen 2026" description="Die Schuldigen hinter dieser Website.">
  <div class="mx-auto max-w-2xl text-center">
    <h2 class="font-heading text-3xl sm:text-4xl text-accent mb-8">Die Schuldigen</h2>

    <figure class="mb-10">
      <img
        src="https://media.giphy.com/media/WsvLlmmjx9tnmeTPNc/giphy.gif"
        alt="Eine Katze im Kiss-Band-Style mit schwarzweißer Gesichtsbemalung headbangt zu Heavy Metal"
        class="mx-auto rounded-lg border border-border max-w-sm w-full"
        loading="lazy"
      />
      <figcaption class="mt-3 text-text-secondary text-sm italic">
        Unsere offizielle Maskottchen-Abteilung
      </figcaption>
    </figure>

    <p class="text-text-secondary mb-8">
      Klick auf einen Namen und lausche den Klängen der Verantwortlichen.
    </p>

    <div class="grid gap-6 sm:grid-cols-3 mb-12">
      <!-- Sascha Metz -->
      <button
        type="button"
        class="sound-btn group rounded-lg border border-border bg-surface-card p-6
               transition-all duration-200 hover:border-accent/40 hover:bg-surface-card-hover
               focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        data-sound="smooth-operator"
        aria-label="Sascha Metz — spielt Smooth Operator ab"
      >
        <div class="text-2xl mb-2 transition-transform duration-200 group-active:scale-125">
          &#127911;
        </div>
        <div class="text-lg font-bold text-text-primary group-hover:text-accent transition-colors">
          Sascha Metz
        </div>
        <div class="text-xs text-text-secondary mt-1">Der Zeremonienmeister</div>
      </button>

      <!-- Dolores Sommer -->
      <button
        type="button"
        class="sound-btn group rounded-lg border border-border bg-surface-card p-6
               transition-all duration-200 hover:border-accent/40 hover:bg-surface-card-hover
               focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        data-sound="star-trek"
        aria-label="Dolores Sommer — spielt Star Trek Theme ab"
      >
        <div class="text-2xl mb-2 transition-transform duration-200 group-active:scale-125">
          &#128640;
        </div>
        <div class="text-lg font-bold text-text-primary group-hover:text-accent transition-colors">
          Dolores Sommer
        </div>
        <div class="text-xs text-text-secondary mt-1">Die Lichtgestalt</div>
      </button>

      <!-- Claude Code -->
      <button
        type="button"
        class="sound-btn group rounded-lg border border-border bg-surface-card p-6
               transition-all duration-200 hover:border-accent/40 hover:bg-surface-card-hover
               focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        data-sound="ai-powerup"
        aria-label="Claude Code — spielt Maschinenklänge ab"
      >
        <div class="text-2xl mb-2 transition-transform duration-200 group-active:scale-125">
          &#129302;
        </div>
        <div class="text-lg font-bold text-text-primary group-hover:text-accent transition-colors">
          Claude Code
        </div>
        <div class="text-xs text-text-secondary mt-1">Der Digitale Roadie</div>
      </button>
    </div>

    <p class="text-text-secondary text-sm">
      Diese Seite wurde mit viel Liebe, Koffein und fragwürdigen Musikgeschmack gebaut.
    </p>
  </div>
</Layout>

<script>
  const audioCtx = new (window.AudioContext || (window as any).webkitAudioContext)();

  function playNote(freq: number, startTime: number, duration: number, type: OscillatorType = 'sine', gain = 0.3) {
    const osc = audioCtx.createOscillator();
    const gainNode = audioCtx.createGain();
    osc.type = type;
    osc.frequency.setValueAtTime(freq, startTime);
    gainNode.gain.setValueAtTime(gain, startTime);
    gainNode.gain.exponentialRampToValueAtTime(0.001, startTime + duration);
    osc.connect(gainNode);
    gainNode.connect(audioCtx.destination);
    osc.start(startTime);
    osc.stop(startTime + duration);
  }

  function playSmoothOperator() {
    const now = audioCtx.currentTime;
    // "Smooooth Operator" vocal melody approximation — warm sine tones
    const melody = [
      { freq: 293.66, dur: 0.6 },  // D4 — "Smoooooth"
      { freq: 329.63, dur: 0.3 },  // E4
      { freq: 369.99, dur: 0.3 },  // F#4
      { freq: 329.63, dur: 0.4 },  // E4
      { freq: 293.66, dur: 0.8 },  // D4 — "Op-er-a-tor"
      { freq: 261.63, dur: 0.3 },  // C4
      { freq: 293.66, dur: 0.6 },  // D4
    ];

    let t = now;
    for (const note of melody) {
      playNote(note.freq, t, note.dur, 'sine', 0.25);
      // Add a subtle octave-up shimmer
      playNote(note.freq * 2, t, note.dur, 'sine', 0.05);
      t += note.dur;
    }
  }

  function playStarTrek() {
    const now = audioCtx.currentTime;
    // Star Trek: Enterprise theme — iconic opening fanfare approximation
    const melody = [
      { freq: 233.08, dur: 1.0 },   // Bb3 — opening long note
      { freq: 349.23, dur: 0.5 },   // F4
      { freq: 466.16, dur: 0.8 },   // Bb4
      { freq: 587.33, dur: 0.5 },   // D5
      { freq: 698.46, dur: 1.2 },   // F5 — soaring high note
    ];

    let t = now;
    for (const note of melody) {
      // Brass-like sawtooth with lower gain
      playNote(note.freq, t, note.dur, 'sawtooth', 0.12);
      // Add body with a sine an octave below
      playNote(note.freq / 2, t, note.dur, 'sine', 0.08);
      t += note.dur * 0.85; // slight overlap for legato feel
    }
  }

  function playAIPowerup() {
    const now = audioCtx.currentTime;
    // Rising arpeggio with stacked oscillators — "AI awakening"
    const notes = [130.81, 164.81, 196.00, 261.63, 329.63, 392.00, 523.25, 659.25];
    const step = 0.12;

    for (let i = 0; i < notes.length; i++) {
      const t = now + i * step;
      // Main tone (square for digital feel)
      playNote(notes[i], t, 0.4, 'square', 0.08);
      // Harmonic (triangle, softer)
      playNote(notes[i] * 1.5, t, 0.3, 'triangle', 0.04);
    }

    // Final power chord
    const chordTime = now + notes.length * step;
    playNote(261.63, chordTime, 1.5, 'sawtooth', 0.1);  // C4
    playNote(329.63, chordTime, 1.5, 'sawtooth', 0.1);  // E4
    playNote(392.00, chordTime, 1.5, 'sawtooth', 0.1);  // G4
    playNote(523.25, chordTime, 1.5, 'sawtooth', 0.06); // C5
  }

  const sounds: Record<string, () => void> = {
    'smooth-operator': playSmoothOperator,
    'star-trek': playStarTrek,
    'ai-powerup': playAIPowerup,
  };

  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.sound-btn');
    if (!btn) return;

    const soundKey = btn.dataset.sound;
    if (!soundKey || !sounds[soundKey]) return;

    // Resume audio context (required by browsers after user gesture)
    if (audioCtx.state === 'suspended') {
      audioCtx.resume();
    }

    sounds[soundKey]();

    // Visual pulse feedback
    btn.classList.add('animate-pulse');
    setTimeout(() => btn.classList.remove('animate-pulse'), 800);
  });
</script>
