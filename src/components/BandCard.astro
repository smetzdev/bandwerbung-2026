---
interface Props {
  bandNameTitleCase: string;
  exampleLink: string;
  hometown: string;
  genre: string[];
}

const { bandNameTitleCase, exampleLink, hometown, genre } = Astro.props;
---

<article
  class="group flex flex-col rounded-lg border border-border bg-surface-card p-5
         transition-colors duration-200 hover:bg-surface-card-hover hover:border-accent/40
         focus-within:ring-2 focus-within:ring-accent"
>
  <h2 class="text-xl font-bold text-text-primary group-hover:text-accent transition-colors">
    {bandNameTitleCase}
  </h2>

  <p class="mt-1 text-sm text-text-secondary">
    <span class="sr-only">Herkunft: </span>
    {hometown}
  </p>

  <div class="mt-3 flex flex-wrap gap-2" role="list" aria-label="Genres">
    {genre.map((g) => (
      <span
        role="listitem"
        class="inline-block rounded-full border border-accent-warm/30 bg-accent-warm/10
               px-2.5 py-0.5 text-xs font-medium text-accent-warm"
      >
        {g}
      </span>
    ))}
  </div>

  <div class="mt-auto pt-4">
    <a
      href={exampleLink}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex w-full items-center justify-center gap-2 rounded-md
             bg-accent px-4 py-2.5 text-sm font-semibold text-white
             transition-colors duration-200 hover:bg-accent-hover
             focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      aria-label={`Anhören: ${bandNameTitleCase}`}
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 20 20"
        fill="currentColor"
        class="h-4 w-4"
        aria-hidden="true"
      >
        <path d="M6.3 2.84A1.5 1.5 0 004 4.11v11.78a1.5 1.5 0 002.3 1.27l9.344-5.891a1.5 1.5 0 000-2.538L6.3 2.841z" />
      </svg>
      Anhören
      <span class="sr-only">(öffnet in neuem Tab)</span>
    </a>
  </div>
</article>
